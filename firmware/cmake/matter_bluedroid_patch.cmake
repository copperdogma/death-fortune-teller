# ESP-Matter 1.5.0's Bluedroid backend accidentally logs instead of formatting
# mDeviceName. Besides failing -Werror=format-nonliteral, suppressing the warning
# would leave the advertised name empty. See esp-matter issue #1441.
# Compile a corrected build-local copy; never mutate the managed component.
set(_matter_backend "${CMAKE_CURRENT_LIST_DIR}/../managed_components/espressif__esp_matter/connectedhomeip/connectedhomeip/src/platform/ESP32/bluedroid/BLEManagerImpl.cpp")
file(SHA256 "${_matter_backend}" _matter_backend_hash)
if(NOT _matter_backend_hash STREQUAL "e580620ef301c7e9fdae628ed07ec9ba8fedf72eca5d6807eeaf4df394ffc506")
    message(FATAL_ERROR "Matter Bluedroid source changed. Review the pinned name-format patch before updating dependencies.")
endif()
file(READ "${_matter_backend}" _matter_backend_source)
set(_bad_name_call "ChipLogProgress(Ble, mDeviceName, sizeof(mDeviceName), \"%s%04u\", CHIP_DEVICE_CONFIG_BLE_DEVICE_NAME_PREFIX, discriminator);")
set(_fixed_name_call "snprintf(mDeviceName, sizeof(mDeviceName), \"%s%04u\", CHIP_DEVICE_CONFIG_BLE_DEVICE_NAME_PREFIX, discriminator);")
string(FIND "${_matter_backend_source}" "${_bad_name_call}" _name_call_position)
if(_name_call_position EQUAL -1)
    message(FATAL_ERROR "Expected Matter name-format defect not found")
endif()
string(REPLACE "${_bad_name_call}" "${_fixed_name_call}" _matter_backend_source "${_matter_backend_source}")
set(_patched_backend "${CMAKE_BINARY_DIR}/skull_patches/BLEManagerImpl.cpp")
file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/skull_patches")
file(WRITE "${_patched_backend}" "${_matter_backend_source}")
idf_component_get_property(_matter_target espressif__esp_matter COMPONENT_LIB)
get_target_property(_matter_sources "${_matter_target}" SOURCES)
set(_replacement_count 0)
set(_patched_sources)
foreach(_source IN LISTS _matter_sources)
    if(_source MATCHES "/bluedroid/BLEManagerImpl\\.cpp$")
        list(APPEND _patched_sources "${_patched_backend}")
        math(EXPR _replacement_count "${_replacement_count}+1")
    else()
        list(APPEND _patched_sources "${_source}")
    endif()
endforeach()
if(NOT _replacement_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one Matter Bluedroid source, found ${_replacement_count}")
endif()
set_property(TARGET "${_matter_target}" PROPERTY SOURCES "${_patched_sources}")
message(STATUS "Matter 1.5.0: applying checked Bluedroid device-name formatting correction")
