# Classic ESP32 WROVER: 4 MB flash, one application, no OTA.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# Use the SDK's supported Matter heap allocator; retain internal stacks/DMA.
CONFIG_CHIP_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# One dual-mode Bluedroid host, retained beyond Matter commissioning.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_NIMBLE_ENABLED is not set
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_GATTS_ENABLE=y
# The combined stack exceeds static DRAM with Bluedroid's default static pools.
# Use the documented dynamic environment and prefer PSRAM for eligible host data.
# Controller/DMA/task stacks still consume internal memory; measure separately.
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=3
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=2
CONFIG_BTDM_CTRL_PINNED_TO_CORE_0=y
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
CONFIG_ESP_WIFI_TASK_PINNED_TO_CORE_1=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# CONFIG_USE_BLE_ONLY_FOR_COMMISSIONING is not set
CONFIG_ENABLE_CHIPOBLE=y

# Matter Wi-Fi station; no SoftAP and no extra web server.
# CONFIG_ESP_WIFI_SOFTAP_SUPPORT is not set
CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=4
CONFIG_MBEDTLS_HKDF_C=y
# Prototype identity only. This is a new accessory, not a copy of the C3 fabric.
# CONFIG_ENABLE_ESP32_FACTORY_DATA_PROVIDER is not set
CONFIG_EXAMPLE_DAC_PROVIDER=y
CONFIG_EXAMPLE_COMMISSIONABLE_DATA_PROVIDER=y
CONFIG_EXAMPLE_DEVICE_INSTANCE_INFO_PROVIDER=y
CONFIG_NONE_DEVICE_INFO_PROVIDER=y
CONFIG_ENABLE_TEST_SETUP_PARAMS=y
CONFIG_USE_TEST_SERIAL_NUMBER="DEATH-WROVER-2026"
# CONFIG_TEST_EVENT_TRIGGER_ENABLED is not set
# CONFIG_ENABLE_OTA_REQUESTOR is not set

# A2DP SBC encoding at 160 MHz starved IDLE0 on the JBL Flip 6 bench.
# Preserve scheduler yields; qualify 240 MHz with the same paired catalogue.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Recursive catalog path buffers live in PSRAM; release main stack after boot.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
